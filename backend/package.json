{
  "name": "backend",
  "version": "1.7.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --inspect=0.0.0.0:9229 src/server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --watchAll=false",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src healthcheck.js",
    "lint:fix": "echo 'Formatting backend code...' && npx prettier --write src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "db:migrate": "node -e \"require('./src/database/migrate')().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:test-connection": "node scripts/test-db-connection.js",
    "security:audit": "npm audit --audit-level=moderate",
    "start:prod": "NODE_ENV=production node src/index.js"
  },
  "author": "Adam Dr. Porkolab",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.19.0"
  },
  "overrides": {
    "dottie": "2.0.7",
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
