{
  "name": "backend",
  "version": "2.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/wait-for-db.js",
    "dev": "nodemon --inspect=0.0.0.0:9229 src/server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --watchAll=false",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "echo 'Linting backend code...' && find src -name '*.js' | head -5",
    "lint:fix": "echo 'Formatting backend code...' && npx prettier --write src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:test-connection": "node scripts/test-db-connection.js",
    "security:audit": "npm audit --audit-level=moderate",
    "start:prod": "NODE_ENV=production node src/server.js"
  },
  "author": "Adam Dr. Porkolab",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.2",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0"
  },
  "overrides": {
    "dottie": "2.0.7",
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
