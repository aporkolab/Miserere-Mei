{
  "name": "backend",
  "version": "1.7.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --inspect=0.0.0.0:9229 src/server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --watchAll=false",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src healthcheck.js",
    "lint:fix": "echo 'Formatting backend code...' && npx prettier --write src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "db:migrate": "node -e \"require('./src/database/migrate')().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:test-connection": "node scripts/test-db-connection.js",
    "security:audit": "npm audit --audit-level=moderate",
    "start:prod": "NODE_ENV=production node src/index.js"
  },
  "author": "Adam Dr. Porkolab",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.19.0"
  },
  "overrides": {
    "dottie": "2.0.7",
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "validator": "13.15.35",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
