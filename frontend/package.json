{
  "name": "miserere-mei",
  "version": "1.7.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:prod": "npx serve -s dist/miserere-mei",
    "build": "ng build --configuration=development",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "coverage": "ng test --code-coverage --watch=false --browsers=ChromeHeadless",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "lint:fix": "echo 'Formatting frontend code...' && npx prettier --write src/**/*.{ts,html,scss,css}",
    "format": "prettier --write src/**/*.{ts,html,scss,css}",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "security:audit": "npm audit --audit-level=moderate",
    "analyze": "ng build --configuration=production --stats-json && npx webpack-bundle-analyzer dist/miserere-mei/stats.json"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.45.1": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "homepage": "https://miserere.aporkolab.com",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "font-awesome": "^4.7.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.1.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.1.0"
  }
}
